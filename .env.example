# Database
DATABASE_URL=postgresql+asyncpg://incident_user:incident_password@postgres:5432/incident_db
DATABASE_TEST_URL=postgresql+asyncpg://incident_user:incident_password@postgres:5432/incident_test_db

# JWT Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# FAISS
FAISS_INDEX_PATH=./rag/vector_store/incidents.index
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Environment
ENVIRONMENT=development
DEBUG=true